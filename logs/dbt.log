[0m17:51:28.091910 [debug] [Thread-1 (]: On model.dbt_ecommerce.cohort_analysis: /* {"app": "dbt", "dbt_version": "1.12.0", "profile_name": "dbt_ecommerce", "target_name": "dev", "node_id": "model.dbt_ecommerce.cohort_analysis"} */

  
    

  create  table "ecommerce_db"."public"."cohort_analysis__dbt_tmp"
  
  
    as
  
  (
    
with customers as (
    Select * from "ecommerce_db"."public"."olist_customers_dataset"
),
orders as(
    SELECT * FROM "ecommerce_db"."public"."olist_orders_dataset"
),
cohort_monht as (select order_id,min(TO_CHAR(order_delivered_customer_date::timestamp, 'YYYY-MM')) as cohort_month
                 from orders
                 group by 1),
customer_unique_id as(
    select c.customer_unique_id, TO_CHAR(o.order_approved_at::timestamp, 'YYYY-MM') as order_month
    from customers c
    join orders o on o.customer_id=c.customer_id
    where o.order_status != 'cancelled'
),
cohort_analysis as(
    select customer_unique_id, extract(year from cu.order_month::timestamp)-extract(month from cm.cohort_monht::timestamp) as month_offset
    from customer_unique_id cu
    join cohort_monht cm on cu.customer_unique_id=cm.customer_id
)
SELECT
    cohort_monht,
    month_offset,
    count(distinct customer_unique_id)
from cohort_analysis
group by cohort_monht, month_offset
order by cohort_monht,month_offset
  );
  
