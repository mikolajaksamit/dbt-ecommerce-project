t,\n    count(distinct customer_unique_id) as active_customers\n\nfrom cohort_activity\n\ngroup by\n    cohort_month,\n    month_offset\n\norder by\n    cohort_month,\n    month_offset", "relation_name": "\"ecommerce_db\".\"public\".\"mrt_cohort_analysis\"", "batch_results": null, "overload_results": null}], "elapsed_time": 1.688781976699829, "args": {"maximum_seed_size_mib": 1, "log_level": "info", "use_fast_test_edges": false, "invocation_command": "dbt run --select mrt_cohort_analysis", "sqlparse": {"MAX_GROUPING_DEPTH": null, "MAX_GROUPING_TOKENS": null}, "vars": {}, "partial_parse_file_diff": true, "require_ref_searches_node_package_before_root": false, "require_source_and_semantic_model_names_without_spaces": false, "strict_mode": false, "state_modified_compare_more_unrendered_values": true, "state_modified_compare_vars": false, "which": "run", "hints_enabled": true, "defer": false, "validate_macro_args": true, "use_catalogs_v2": false, "introspect": true, "send_anonymous_usage_stats": true, "support_custom_ref_kwargs": false, "exclude": [], "macro_debugging": false, "log_format_file": "debug", "empty": false, "enable_grouped_warn_error_parser_logs": false, "log_file_max_bytes": 10485760, "v2_parser": "dbt-core-experimental-parser parse", "static_parser": true, "write_json": true, "require_nested_cumulative_type_params": true, "favor_state": false, "log_path": "/Users/mikolajaksamit/Downloads/E-commerce Project/Data/dbt_ecommerce/logs", "require_all_warnings_handled_by_warn_error": true, "upload_to_artifacts_ingest_api": false, "allow_jinja_file_extensions": false, "require_resource_names_without_spaces": true, "use_colors_file": true, "require_sql_header_in_test_configs": false, "latest_version_pointer_enabled_by_default": false, "project_dir": "/Users/mikolajaksamit/Downloads/E-commerce Project/Data/dbt_ecommerce", "indirect_selection": "eager", "require_batched_execution_for_custom_microbatch_strategy": true, "skip_nodes_if_on_run_start_fails": true, "use_c